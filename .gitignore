# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# 查看器静态资源（由 scripts/copy-vendor.mjs 从 node_modules 复制）
/public/vendor

# Office 预览转换缓存
/.cache

# 数据库文件（第 ③ 步）：服务器上的真实数据，不提交
/.data/

# 部署：配置模板要提交，真实配置和数据不提交
!deploy/.env.example
/deploy/data/
/deploy/caddy/
