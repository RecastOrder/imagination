# 复制成 deploy/.env 再填写（.env 不要提交到仓库）

# 你的域名（已解析到这台服务器；中国大陆的服务器需要先完成 ICP 备案）
DOMAIN=imagination.example.com
# 平台的完整网址：邮件里的链接会用它
APP_URL=https://imagination.example.com

# 会话签名密钥：一串足够长的随机字符，生成方法：openssl rand -base64 48
AUTH_SECRET=

# 邮件（Resend）：在 resend.com 创建 API Key，并验证发件域名
RESEND_API_KEY=
RESEND_FROM=Imagination <noreply@example.com>

# 第一位管理员的工作邮箱：启动后这个邮箱可以登录，再在“成员与权限”里邀请其他人
INITIAL_ADMIN_EMAIL=

# 演示数据（示例成员、示例项目）：试用演示时设 1，正式使用设 0
DEMO_DATA=0
# 登录页直接显示验证码（仅供没有配置邮件时内部演示用，正式使用千万不要打开）
# AUTH_DEMO=on
# 还没有 HTTPS（例如备案期间用 IP 访问）时临时设为 1，否则浏览器不保存登录状态；有了 HTTPS 一定删掉
# AUTH_INSECURE_COOKIE=1
